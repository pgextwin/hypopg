{
  "schemaVersion": 1,
  "distribution": "dll-sql",
  "files": [
    {
      "source": "upstream",
      "path": "hypopg.dll",
      "destination": "lib/hypopg.dll",
      "targets": ["install", "zip"]
    },
    {
      "source": "upstream",
      "path": "hypopg.control",
      "destination": "share/extension/hypopg.control",
      "targets": ["install", "zip"]
    },
    {
      "source": "upstream",
      "path": "hypopg--*.sql",
      "destination": "share/extension/{fileName}",
      "targets": ["install", "zip"],
      "expectedCount": 13
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": ["zip"]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": ["zip"]
    },
    {
      "source": "packaging",
      "path": "README.md",
      "destination": "PGEXTWIN-README.md",
      "targets": ["zip"]
    }
  ],
  "packageInfoFinalNewline": false,
  "packageInfo": [
    "HypoPG Windows x64 (unofficial pgextwin pilot)",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref: {upstreamRef}",
    "Upstream commit: {upstreamCommit}",
    "Version: {version}",
    "PostgreSQL major: {pgMajor}",
    "PostgreSQL tested: {pgTested}",
    "Architecture: {architecture}",
    "License: PostgreSQL; see LICENSE",
    "Install by copying lib/hypopg.dll and share/extension files to the respective PostgreSQL directories.",
    "Then run CREATE EXTENSION hypopg. This is not an official HypoPG release."
  ]
}
